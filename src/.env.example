# OpenAI API key — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Gmail address used to SEND the digest
GMAIL_USER=you@gmail.com

# Gmail App Password (not your regular password)
# Generate at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address that RECEIVES the digest (can be the same as GMAIL_USER)
RECIPIENT_EMAIL=you@gmail.com

# Path to resume inside the container — default uses the baked-in myresume file
RESUME_PATH=/app/agent/myresume

# What time to send the daily digest (24-hour, UTC by default)
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0

# Preferred job location — use "Remote" for remote-only
JOB_LOCATION=Remote

# Max jobs to fetch per job title per board (keep ≤ 20 to avoid rate limits)
MAX_JOBS_PER_BOARD=15

# Minimum GPT relevance score to include a job in the digest (1-10)
MIN_RELEVANCE_SCORE=7

# Max jobs included in the final email
MAX_EMAIL_JOBS=30
