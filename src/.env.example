# ── AI Provider ──────────────────────────────────────────────────────────────
# Provider: "openai" (default) or "anthropic" (to use Claude)
AI_PROVIDER=openai

# Model to use — defaults: gpt-4o-mini (OpenAI) | claude-sonnet-4-6 (Anthropic)
AI_MODEL=gpt-4o-mini

# OpenAI API key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic API key — fill in when switching to Claude
ANTHROPIC_API_KEY=


# ── Email ─────────────────────────────────────────────────────────────────────
# Gmail address used to SEND the digest and alerts
GMAIL_USER=you@gmail.com

# Gmail App Password (not your regular password)
# Generate at: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Email address that RECEIVES the digest
RECIPIENT_EMAIL=you@gmail.com


# ── Schedule ──────────────────────────────────────────────────────────────────
# What time to send the daily digest (24-hour UTC)
SCHEDULE_HOUR=18
SCHEDULE_MINUTE=0


# ── Job search ────────────────────────────────────────────────────────────────
# Path to resume file — default uses the baked-in myresume
RESUME_PATH=/app/agent/myresume

# Preferred job location — use "Remote" for remote-only
JOB_LOCATION=Remote

# Max jobs to fetch per job title per board (keep ≤ 20 to avoid rate limits)
MAX_JOBS_PER_BOARD=15

# Minimum AI relevance score to include a job in the digest (1-10)
MIN_RELEVANCE_SCORE=7

# Max jobs included in the final email
MAX_EMAIL_JOBS=30


# ── Dashboard ────────────────────────────────────────────────────────────────
# Public URL of this service (used for feedback links in emails)
# Local dev: http://localhost:5000
# Fly.io:    https://job-search-agent.fly.dev
DASHBOARD_URL=http://localhost:5000
DASHBOARD_PORT=5000

# Path to the SQLite database
# Local dev: omit to use src/data/codeshali.db
# Docker/Fly: /data/codeshali.db (on the persistent volume)
DB_PATH=/data/codeshali.db


# ── Alerts (immediate email/Slack for 9+ scores) ─────────────────────────────
ENABLE_ALERTS=true

# Score threshold for immediate alerts (separate from the daily digest)
ALERT_SCORE_THRESHOLD=9

# Override alert recipient (defaults to RECIPIENT_EMAIL)
ALERT_EMAIL=

# Slack webhook URL — if set, alerts go to Slack instead of email
# Create at: api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=


# ── Cover letters ─────────────────────────────────────────────────────────────
# Generate a tailored cover letter when you click "Interested" on a job
ENABLE_COVER_LETTERS=true
